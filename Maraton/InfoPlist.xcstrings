        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maratonia lee tus entrenamientos y tu frecuencia cardíaca de Apple Health para registrar tus carreras y mostrar tu progreso y tus marcas."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
