    "%@ necesita al menos %lld días por semana. Con menos, la tirada larga pasa a dominar la semana y el plan deja de ser ese plan: preferimos decírtelo antes que armarte algo que no se sostiene.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ needs at least %lld days per week. With fewer, the long run takes over the week and the plan stops being that plan: we'd rather tell you now than build you something that doesn't hold up."
          }
        }
      }
    },
    "%@ sin pasar de %@ /km": {
