rules_version = '2';

// Firestore es EXCLUSIVO del backend del Coach: rate limit (uso/),
// cache de idempotencia (respuestas/) y flags (config/coach).
//
// Ningún cliente lee ni escribe nada. La app iOS ni siquiera enlaza el
// SDK de Firestore — si algún día lo hiciera, estas reglas la frenan.
// Las Cloud Functions usan el Admin SDK, que pasa por encima de las
// reglas: por eso negar todo acá no rompe el backend.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
